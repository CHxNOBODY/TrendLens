# คัดลอกเป็น .env แล้วแก้ไข:  Copy-Item .env.example .env
# ไฟล์ .env อยู่ใน .gitignore — อย่า commit และอย่าใส่ key ในตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_

# ---------- แหล่งข้อมูล ----------
# auto   = มี Alpaca key → ใช้ Alpaca, ไม่มี → Demo Mode
# demo   = บังคับ Demo Mode
# alpaca = ใช้ Alpaca (ถ้าไม่มี key จะกลับไป Demo พร้อมแจ้งเหตุผล)
DATA_PROVIDER=auto

# Alpaca Market Data (อ่านเฉพาะฝั่ง worker/server)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# iex         = real-time เฉพาะ IEX exchange (แผนฟรี Basic)
# sip         = real-time ทุกตลาด (ต้องมี Algo Trader Plus)
# delayed_sip = ทุกตลาดแต่ล่าช้า 15 นาที (แสดงป้าย DELAYED)
ALPACA_FEED=iex
# การปรับราคาข้อมูลย้อนหลัง: split (ค่าเริ่มต้น) | all (split + เงินปันผล) | raw
ALPACA_ADJUSTMENT=split

# ---------- ตลาดและการคำนวณ ----------
# regular = 09:30–16:00 ET (ค่าเริ่มต้น) | extended = 04:00–20:00 ET  — ใช้เหมือนกันทั้งกราฟ กลยุทธ์ และ backtest
MARKET_SESSION=regular
# รอให้แท่งนาทีสุดท้ายมาถึงก่อนถือว่าแท่งปิด (วินาที) และ grace ของแท่งรายวัน (นาที)
BAR_CLOSE_GRACE_SEC=15
DAILY_CLOSE_GRACE_MIN=20
# ไม่ได้รับข้อมูลเกินกี่วินาทีระหว่างตลาดเปิด → ถือว่า "ข้อมูลค้าง" และพักสัญญาณ
STALE_AFTER_SEC=120
# ดึงข้อมูลย้อนหลังครั้งแรก (วันปฏิทิน)
INTRADAY_HISTORY_DAYS=30
DAILY_HISTORY_DAYS=1100

# ---------- หน้าจอ / worker ----------
UI_REFRESH_MS=2000
WORKER_TICK_MS=1000
STREAM_QUEUE_CAPACITY=20000
# TRENDLENS_DB_PATH=data/trendlens.db

# ---------- Demo Mode ----------
# เวลาเริ่มของนาฬิกาจำลอง (เวลานิวยอร์ก) และความเร็ว (เท่า)
DEMO_START=2026-10-01T10:00
DEMO_SPEED=10
# จำลองการหลุดการเชื่อมต่อทุก N วินาที (0 = ปิด) เพื่อทดสอบ reconnect/backfill
DEMO_DROP_EVERY_SEC=0
